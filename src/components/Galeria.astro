---
// Galería: la primera foto va grande y el resto la rodea. Pensada para 3 o 5 fotos.
import Foto from "./Foto.astro";

interface Props {
  fotos: { src: string; alt: string }[];
  nota?: string;
}

const { fotos, nota } = Astro.props;
const columnas = fotos.length === 3 ? "md:grid-cols-3" : "md:grid-cols-4";
---

<div class={`grid auto-rows-[8.5rem] grid-cols-2 gap-3 sm:auto-rows-[11rem] ${columnas}`}>
  {fotos.map((f, i) => (
    <figure class={`overflow-hidden rounded-2xl bg-black/5 ${i === 0 ? "col-span-2 row-span-2" : ""}`}>
      <Foto src={f.src} alt={f.alt} ancho={i === 0 ? 1200 : 600} class="h-full w-full object-cover transition duration-500 hover:scale-105" />
    </figure>
  ))}
</div>
{nota && <p class="mt-3 text-sm text-black/55">{nota}</p>}

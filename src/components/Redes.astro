---
// Íconos de Instagram, Facebook y YouTube. Se pasa el link completo de cada red.
// Si una red no tiene link, el ícono se muestra igual (de ejemplo) pero no lleva a ningún lado.
interface Props {
  instagram?: string;
  facebook?: string;
  youtube?: string;
  negocio: string;
  nota?: string;
  class?: string;
}

const { instagram = "", facebook = "", youtube = "", negocio, nota, class: clase = "" } = Astro.props;

const redes = [
  { nombre: "Instagram", url: instagram },
  { nombre: "Facebook", url: facebook },
  { nombre: "YouTube", url: youtube },
];
const boton = "inline-flex h-11 w-11 items-center justify-center rounded-full bg-(--accent-dark) text-white transition";
---

<div class={clase}>
  <p class="text-sm font-semibold">Seguinos en redes</p>
  <div class="mt-3 flex gap-3">
    {redes.map((r) => {
      const icono = (
        <svg viewBox="0 0 24 24" class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          {r.nombre === "Instagram" && (
            <>
              <rect x="3" y="3" width="18" height="18" rx="5" />
              <circle cx="12" cy="12" r="4" />
              <circle cx="17.5" cy="6.5" r="0.6" fill="currentColor" />
            </>
          )}
          {r.nombre === "Facebook" && <path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z" />}
          {r.nombre === "YouTube" && (
            <>
              <rect x="2" y="5" width="20" height="14" rx="4" />
              <path d="m10 9 5 3-5 3z" fill="currentColor" />
            </>
          )}
        </svg>
      );
      return r.url ? (
        <a href={r.url} target="_blank" rel="noopener" aria-label={`${r.nombre} de ${negocio}`} class={`${boton} hover:bg-(--accent)`}>{icono}</a>
      ) : (
        <span role="img" aria-label={`${r.nombre} (ejemplo)`} title={`Acá va el link al ${r.nombre} de ${negocio}`} class={boton}>{icono}</span>
      );
    })}
  </div>
  {nota && <p class="mt-2 text-xs opacity-60">{nota}</p>}
</div>

---
// Catálogo con buscador y filtro por categoría; cada producto se consulta por WhatsApp.
// Los colores salen de las variables --accent, --accent-dark y --soft del contenedor.
import { waLink } from "../config";
import Foto from "./Foto.astro";

interface Producto {
  nombre: string;
  categoria: string;
  precio?: number;
  nota?: string;
  img?: string;
}

interface Props {
  productos: Producto[];
  prefijo: string;
}

const { productos, prefijo } = Astro.props;
const categorias = ["Todos", ...new Set(productos.map((p) => p.categoria))];
const fmt = (n: number) => n.toLocaleString("es-AR");
---

<div class="flex flex-col gap-3 sm:flex-row sm:items-center">
  <input id="buscar" type="search" placeholder="Buscar producto..." class="w-full rounded-full border border-black/20 bg-white px-4 py-2 sm:max-w-xs" />
  <div class="flex flex-wrap gap-2">
    {categorias.map((c, i) => (
      <button type="button" data-cat={c} class={`rounded-full px-4 py-1.5 text-sm ring-1 ring-black/20 ${i === 0 ? "bg-(--accent-dark) text-white" : "bg-white"}`}>{c}</button>
    ))}
  </div>
</div>
<div class="mt-6 grid grid-cols-2 gap-3 md:grid-cols-3">
  {productos.map((p) => (
    <div data-producto data-nombre={p.nombre.toLowerCase()} data-categoria={p.categoria} class="flex flex-col overflow-hidden rounded-2xl bg-white ring-1 ring-black/10">
      {p.img && (
        <div class="aspect-[4/3] bg-(--soft)">
          <Foto src={p.img} alt={p.nombre} ancho={600} class="h-full w-full object-cover" />
        </div>
      )}
      <div class="flex flex-1 flex-col p-3 sm:p-5">
        <span class="self-start rounded-full bg-(--soft) px-2 py-0.5 text-xs font-medium">{p.categoria}</span>
        <p class="mt-2 flex-1 text-sm leading-snug font-semibold sm:mt-3 sm:text-base">{p.nombre}</p>
        {p.precio !== undefined && <p class="mt-2 font-bold text-(--accent-dark) sm:text-lg">${fmt(p.precio)}</p>}
        {p.nota && <p class="mt-2 text-xs text-black/60 sm:text-sm">{p.nota}</p>}
        <a href={waLink(`${prefijo} Hola, quería consultar por "${p.nombre}".`)} target="_blank" rel="noopener" class="mt-3 text-sm font-semibold text-(--accent-dark) hover:underline"><span class="sm:hidden">Consultar →</span><span class="hidden sm:inline">Consultar por WhatsApp →</span></a>
      </div>
    </div>
  ))}
</div>
<p id="sin-resultados" class="mt-6 hidden text-black/60">No encontramos ese producto. Escribinos y lo conseguimos.</p>

<script is:inline>
  let categoria = "Todos";
  const buscar = document.getElementById("buscar");

  function filtrar() {
    const q = buscar.value.trim().toLowerCase();
    let visibles = 0;
    document.querySelectorAll("[data-producto]").forEach((el) => {
      const ok = (categoria === "Todos" || el.dataset.categoria === categoria) && el.dataset.nombre.includes(q);
      el.classList.toggle("hidden", !ok);
      if (ok) visibles++;
    });
    document.getElementById("sin-resultados").classList.toggle("hidden", visibles > 0);
  }

  document.querySelectorAll("[data-cat]").forEach((b) =>
    b.addEventListener("click", () => {
      categoria = b.dataset.cat;
      document.querySelectorAll("[data-cat]").forEach((x) => {
        x.classList.toggle("bg-(--accent-dark)", x === b);
        x.classList.toggle("text-white", x === b);
        x.classList.toggle("bg-white", x !== b);
      });
      filtrar();
    })
  );
  buscar.addEventListener("input", filtrar);
</script>

---
// Calendario de temporadas: una fila por especie o actividad, con los meses habilitados pintados.
// Los meses van de 1 (enero) a 12 (diciembre); "destacado" marca un tramo especial, como la brama.
interface Fila {
  nombre: string;
  meses: [number, number][];
  destacado?: { meses: [number, number]; etiqueta: string };
  detalle?: string;
}

interface Props {
  filas: Fila[];
  nota?: string;
}

const { filas, nota } = Astro.props;
const iniciales = ["E", "F", "M", "A", "M", "J", "J", "A", "S", "O", "N", "D"];
const dentro = (m: number, [a, b]: [number, number]) => m >= a && m <= b;
const etiquetas = [...new Set(filas.flatMap((f) => (f.destacado ? [f.destacado.etiqueta] : [])))];
---

<div class="rounded-3xl bg-white p-5 shadow-sm ring-1 ring-black/5 sm:p-7">
  <div class="grid gap-x-6 sm:grid-cols-[11rem_1fr]">
    <div class="hidden sm:block"></div>
    <div class="grid grid-cols-12 gap-1 text-center text-xs font-semibold text-black/50">
      {iniciales.map((m) => <span>{m}</span>)}
    </div>
    {filas.map((f) => (
      <>
        <div class="mt-4 sm:mt-3 sm:self-center">
          <p class="font-semibold leading-tight">{f.nombre}</p>
          {f.detalle && <p class="text-xs text-black/55">{f.detalle}</p>}
        </div>
        <div class="mt-1.5 grid grid-cols-12 gap-1 sm:mt-3 sm:self-center">
          {iniciales.map((_, i) => {
            const m = i + 1;
            const fuerte = f.destacado && dentro(m, f.destacado.meses);
            const activo = f.meses.some((r) => dentro(m, r));
            return <span class={`h-4 rounded-sm ${fuerte ? "bg-(--accent-dark)" : activo ? "bg-(--accent)/60" : "bg-black/5"}`}></span>;
          })}
        </div>
      </>
    ))}
  </div>
  <div class="mt-5 flex flex-wrap gap-x-5 gap-y-1 text-xs text-black/60">
    <span class="flex items-center gap-1.5"><span class="h-3 w-3 rounded-sm bg-(--accent)/60"></span>Temporada abierta</span>
    {etiquetas.map((e) => <span class="flex items-center gap-1.5"><span class="h-3 w-3 rounded-sm bg-(--accent-dark)"></span>{e}</span>)}
  </div>
</div>
{nota && <p class="mt-3 text-sm text-black/55">{nota}</p>}

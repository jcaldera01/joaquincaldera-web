---
// Menú con carrito que arma el pedido y lo manda por WhatsApp.
// Los colores salen de las variables --accent, --accent-dark y --soft del contenedor.
import { SITE } from "../config";
import Foto from "./Foto.astro";

interface Item {
  id: string;
  nombre: string;
  precio: number;
  nota?: string;
  img?: string;
}

interface Props {
  menu: { categoria: string; items: Item[] }[];
  negocio: string;
  prefijo: string;
  envio?: number;
  propinas?: number[]; // montos de los botones de propina; [] la saca
  telefono?: string;
}

const { menu, negocio, prefijo, envio = 0, propinas = [500, 1000, 1500, 2000], telefono = SITE.whatsapp } = Astro.props;
const precios = Object.fromEntries(menu.flatMap((c) => c.items.map((i) => [i.id, { nombre: i.nombre, precio: i.precio }])));
const fmt = (n: number) => n.toLocaleString("es-AR");
---

<nav class="sticky top-9 z-30 border-b border-black/5 bg-(--soft)/95 backdrop-blur sm:top-10">
  <div class="mx-auto flex max-w-5xl gap-2 overflow-x-auto px-4 py-3 text-sm font-medium">
    {menu.map((c) => <a href={`#${c.categoria}`} class="shrink-0 rounded-full bg-white px-4 py-1.5 ring-1 ring-black/10 hover:bg-(--soft)">{c.categoria}</a>)}
  </div>
</nav>

<div class="mx-auto max-w-5xl px-4 pb-32">
  {menu.map((c) => (
    <section id={c.categoria} class="scroll-mt-28 pt-10">
      <h2 class="font-display text-2xl font-bold text-(--accent-dark)">{c.categoria}</h2>
      <div class="mt-4 grid gap-3 sm:grid-cols-2">
        {c.items.map((item) => (
          <div class="flex gap-3 rounded-2xl bg-white p-3 shadow-sm ring-1 ring-black/5">
            {item.img && <Foto src={item.img} alt={item.nombre} ancho={240} class="h-24 w-24 shrink-0 rounded-xl bg-(--soft) object-cover" />}
            <div class="flex min-w-0 flex-1 flex-col pl-1">
              <p class="leading-snug font-semibold">{item.nombre}</p>
              {item.nota && <p class="mt-0.5 text-sm leading-snug text-black/55">{item.nota}</p>}
              <div class="mt-auto flex items-center justify-between gap-2 pt-2">
                <p class="font-semibold text-(--accent)">${fmt(item.precio)}</p>
                <div class="flex shrink-0 items-center gap-2">
                  <button data-menos={item.id} class="h-9 w-9 rounded-full bg-black/5 text-lg font-bold hover:bg-black/10" aria-label={`Quitar ${item.nombre}`}>−</button>
                  <span data-cant={item.id} class="w-5 text-center font-semibold">0</span>
                  <button data-mas={item.id} class="h-9 w-9 rounded-full bg-(--accent) text-lg font-bold text-white hover:bg-(--accent-dark)" aria-label={`Agregar ${item.nombre}`}>+</button>
                </div>
              </div>
            </div>
          </div>
        ))}
      </div>
    </section>
  ))}

  <section id="pedido" class="mt-12 scroll-mt-16 rounded-3xl bg-white p-6 shadow-sm ring-1 ring-black/5">
    <h2 class="font-display text-2xl font-bold text-(--accent-dark)">Tu pedido</h2>
    <ul id="resumen" class="mt-4 space-y-1 text-sm"></ul>
    <p id="vacio" class="mt-4 text-sm text-black/55">Todavía no agregaste nada.</p>
    <form id="form-pedido" class="mt-6 grid gap-5 sm:grid-cols-2">
      <label class="text-sm font-medium">Nombre
        <input name="nombre" required class="mt-1 w-full rounded-xl border border-black/15 px-3 py-2" />
      </label>
      <fieldset class="text-sm font-medium">
        <legend>Entrega</legend>
        <div class="mt-1 grid grid-cols-2 gap-2 font-normal">
          <label class="flex cursor-pointer items-start gap-2 rounded-xl p-3 ring-1 ring-black/15 has-checked:bg-(--soft) has-checked:ring-2 has-checked:ring-(--accent)">
            <input type="radio" name="entrega" value="retiro" checked class="mt-0.5 accent-(--accent)" />
            <span><span class="block font-semibold">Retiro</span><span class="text-black/55">Sin cargo</span></span>
          </label>
          <label class="flex cursor-pointer items-start gap-2 rounded-xl p-3 ring-1 ring-black/15 has-checked:bg-(--soft) has-checked:ring-2 has-checked:ring-(--accent)">
            <input type="radio" name="entrega" value="delivery" class="mt-0.5 accent-(--accent)" />
            <span><span class="block font-semibold">Delivery</span><span class="text-black/55">{envio ? `+$${fmt(envio)}` : "Te lo llevamos"}</span></span>
          </label>
        </div>
      </fieldset>
      <label id="campo-direccion" class="hidden text-sm font-medium sm:col-span-2">Dirección
        <input name="direccion" class="mt-1 w-full rounded-xl border border-black/15 px-3 py-2" placeholder="Calle, número y alguna referencia" />
      </label>
      <label class="text-sm font-medium sm:col-span-2">Comentarios
        <textarea name="comentario" rows="2" class="mt-1 w-full rounded-xl border border-black/15 px-3 py-2" placeholder="Sin cebolla, paga con efectivo, etc."></textarea>
      </label>
      {propinas.length > 0 && (
        <fieldset class="sm:col-span-2">
          <legend class="text-sm font-medium">¿Querés dejar propina?</legend>
          <p id="propina-para" class="text-sm text-black/55">Va completa para el equipo.</p>
          <div class="mt-3 flex flex-wrap gap-2">
            {[0, ...propinas].map((m) => (
              <button type="button" data-propina={m} aria-pressed={m === 0 ? "true" : "false"} class="rounded-full bg-black/5 px-4 py-2 text-sm font-semibold aria-pressed:bg-(--accent-dark) aria-pressed:text-white">${fmt(m)}</button>
            ))}
            <button type="button" data-propina="otro" aria-pressed="false" class="rounded-full bg-black/5 px-4 py-2 text-sm font-semibold aria-pressed:bg-(--accent-dark) aria-pressed:text-white">Otro</button>
          </div>
          <div id="campo-propina" class="mt-3 hidden max-w-48">
            <label class="text-sm font-medium">Monto de la propina
              <span class="mt-1 flex items-center rounded-xl border border-black/15 px-3 focus-within:ring-2 focus-within:ring-(--accent)">$
                <input name="propina" type="number" min="0" inputmode="numeric" class="w-full py-2 pl-1 outline-none" />
              </span>
            </label>
          </div>
        </fieldset>
      )}
      <p id="error-pedido" class="hidden text-sm font-medium text-red-700 sm:col-span-2">Agregá al menos un producto.</p>
      <button id="boton-enviar" class="btn-wa text-base sm:col-span-2" type="submit">Enviar pedido por WhatsApp</button>
    </form>
  </section>
</div>

<a href="#pedido" id="barra-total" class="fixed inset-x-4 bottom-4 z-40 mx-auto hidden max-w-md items-center justify-between rounded-full bg-(--accent-dark) px-6 py-4 text-white shadow-2xl">
  <span><span id="items-total">0</span> productos</span>
  <span class="font-semibold">Ver pedido · $<span id="monto-total">0</span></span>
</a>

<script is:inline define:vars={{ precios, telefono, envio, negocio, prefijo }}>
  const carrito = {};
  let propina = 0;
  let pedidoEnPantalla = false;
  const form = document.getElementById("form-pedido");
  const fmt = (n) => n.toLocaleString("es-AR");
  const subtotal = () => Object.entries(carrito).reduce((s, [id, c]) => s + precios[id].precio * c, 0);
  const esDelivery = () => form.entrega.value === "delivery";
  const costoEnvio = () => (esDelivery() ? envio : 0);
  const total = () => subtotal() + costoEnvio() + propina;
  const fila = (texto, monto, clase = "") => `<li class="flex justify-between ${clase}"><span>${texto}</span><span>$${fmt(monto)}</span></li>`;

  function render() {
    const cantidad = Object.values(carrito).reduce((a, b) => a + b, 0);
    document.querySelectorAll("[data-cant]").forEach((el) => (el.textContent = carrito[el.dataset.cant] || 0));
    document.getElementById("items-total").textContent = cantidad;
    document.getElementById("monto-total").textContent = fmt(total());
    document.getElementById("boton-enviar").textContent = cantidad ? `Enviar pedido · $${fmt(total())}` : "Enviar pedido por WhatsApp";
    const barra = document.getElementById("barra-total");
    const verBarra = cantidad > 0 && !pedidoEnPantalla;
    barra.classList.toggle("hidden", !verBarra);
    barra.classList.toggle("flex", verBarra);
    document.getElementById("vacio").classList.toggle("hidden", cantidad > 0);
    if (cantidad) document.getElementById("error-pedido").classList.add("hidden");
    const extras = [costoEnvio() ? fila("Envío", costoEnvio()) : "", propina ? fila("Propina", propina) : ""].join("");
    document.getElementById("resumen").innerHTML = cantidad
      ? Object.entries(carrito).map(([id, c]) => fila(`${c} × ${precios[id].nombre}`, precios[id].precio * c)).join("") +
        (extras ? fila("Subtotal", subtotal(), "border-t border-black/10 pt-2 text-black/60") + extras : "") +
        fila("Total", total(), "border-t border-black/10 pt-2 text-base font-semibold")
      : "";
    const direccion = document.getElementById("campo-direccion");
    direccion.classList.toggle("hidden", !esDelivery());
    form.direccion.required = esDelivery();
    const para = document.getElementById("propina-para");
    if (para) para.textContent = esDelivery() ? "Va completa para quien te lleva el pedido." : "Va completa para el equipo.";
  }

  document.addEventListener("click", (e) => {
    const mas = e.target.closest("[data-mas]");
    const menos = e.target.closest("[data-menos]");
    const boton = e.target.closest("[data-propina]");
    if (mas) carrito[mas.dataset.mas] = (carrito[mas.dataset.mas] || 0) + 1;
    if (menos && carrito[menos.dataset.menos]) {
      carrito[menos.dataset.menos] -= 1;
      if (!carrito[menos.dataset.menos]) delete carrito[menos.dataset.menos];
    }
    if (boton) {
      document.querySelectorAll("[data-propina]").forEach((b) => b.setAttribute("aria-pressed", b === boton ? "true" : "false"));
      const otro = boton.dataset.propina === "otro";
      document.getElementById("campo-propina").classList.toggle("hidden", !otro);
      propina = otro ? Math.max(0, Number(form.propina.value) || 0) : Number(boton.dataset.propina);
      if (otro) form.propina.focus();
    }
    if (mas || menos || boton) render();
  });

  form.addEventListener("change", render);
  form.addEventListener("input", (e) => {
    if (e.target.name !== "propina") return;
    propina = Math.max(0, Number(e.target.value) || 0);
    render();
  });

  // La barra de abajo se esconde mientras se ve el formulario, para que no tape el botón de enviar.
  new IntersectionObserver(([entrada]) => {
    pedidoEnPantalla = entrada.isIntersecting;
    render();
  }).observe(form);

  form.addEventListener("submit", (e) => {
    e.preventDefault();
    if (!Object.keys(carrito).length) {
      document.getElementById("error-pedido").classList.remove("hidden");
      return;
    }
    const d = new FormData(form);
    const lineas = Object.entries(carrito).map(([id, c]) => `• ${c} × ${precios[id].nombre} — $${fmt(precios[id].precio * c)}`);
    const texto = [
      `*${prefijo} Pedido para ${negocio}*`,
      ...lineas,
      costoEnvio() ? `• Envío — $${fmt(costoEnvio())}` : null,
      propina ? `• Propina — $${fmt(propina)}` : null,
      `*Total: $${fmt(total())}*`,
      "",
      `Nombre: ${d.get("nombre")}`,
      esDelivery() ? `Delivery a: ${d.get("direccion")}` : "Retiro en el local",
      d.get("comentario") ? `Comentarios: ${d.get("comentario")}` : null,
    ]
      .filter((l) => l !== null)
      .join("\n");
    window.open(`https://wa.me/${telefono}?text=${encodeURIComponent(texto)}`, "_blank");
  });
</script>

---
import Base from "../layouts/Base.astro";
---

<Base title="Página no encontrada | Joaquín Caldera" description="La página que buscás no existe.">
  <main class="mx-auto flex min-h-screen max-w-xl flex-col items-center justify-center px-4 text-center">
    <h1 class="font-display text-4xl font-bold">Esta página no existe</h1>
    <p class="mt-3 text-monte-900/70">Puede que el link esté mal escrito.</p>
    <a href="/" class="btn-primary mt-6">Volver al inicio</a>
  </main>
</Base>

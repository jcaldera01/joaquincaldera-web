---
import Base from "../layouts/Base.astro";
import Foto from "../components/Foto.astro";
import { SITE, waLink } from "../config";
import { F } from "../fotos";

const contacto = waLink("Hola Joaquín, quiero consultar por una página web para mi negocio.");

const problemas = [
  {
    titulo: "Te preguntan \"¿precio?\" todo el día",
    texto: "Respondés lo mismo por mensaje privado una y otra vez. Con una web, el cliente ve todo y te escribe con el pedido ya armado.",
  },
  {
    titulo: "En Google no aparecés",
    texto: "Quien busca \"rotisería en Toay\" o \"peluquería en Santa Rosa\" no entra a Instagram: entra a Google Maps y a los sitios web.",
  },
  {
    titulo: "Dependés del algoritmo",
    texto: "Si Instagram baja tu alcance o te bloquea la cuenta, te quedás sin vidriera. Tu web es tuya y siempre está.",
  },
];

const demos = [
  {
    href: "/demos/rotiseria",
    rubro: "Rotisería y pizzería",
    nombre: "La Tranquera",
    texto: "Menú con precios y carrito que manda el pedido armado por WhatsApp, con delivery o retiro.",
    img: F.empanadas,
  },
  {
    href: "/demos/peluqueria",
    rubro: "Peluquería y estética",
    nombre: "Estudio Malva",
    texto: "Turnos online: elegís servicio, profesional, día y hora. Se puede cobrar seña con Mercado Pago.",
    img: F.salon,
  },
  {
    href: "/demos/veterinaria",
    rubro: "Veterinaria y pet shop",
    nombre: "El Caldén",
    texto: "Servicios, guardia, catálogo del pet shop con buscador y consulta directa por cada producto.",
    img: F.vetGato,
  },
  {
    href: "/demos/coto",
    rubro: "Coto de caza y turismo rural",
    nombre: "Las Libélulas",
    texto: "Especies, calendario de temporadas, el casco y consulta de fechas con llegada, salida y cantidad de cazadores.",
    img: F.ciervo,
  },
];

const rubros = [
  { nombre: "Rotiserías y comidas", img: F.empanadasDocena },
  { nombre: "Peluquerías y estética", img: F.corte },
  { nombre: "Veterinarias y pet shops", img: F.cachorro },
  { nombre: "Gimnasios", img: F.gimnasio },
  { nombre: "Bares y restaurantes", img: F.bodegon },
  { nombre: "Camping y pesca", img: F.carpa },
];

const planes = [
  {
    nombre: "Vidriera",
    para: "Para que te encuentren",
    items: ["Una página con todo lo importante", "Horarios, mapa y botón de WhatsApp", "Ficha de Google Maps optimizada", "Informe mensual de visitas"],
  },
  {
    nombre: "Catálogo",
    para: "Para mostrar lo que vendés",
    items: ["Todo lo de Vidriera", "Menú o catálogo con precios", "Panel para cambiar precios y fotos", "Informe con clics a WhatsApp y búsquedas en Google"],
    destacado: true,
  },
  {
    nombre: "Ventas",
    para: "Para vender o dar turnos online",
    items: ["Todo lo de Catálogo", "Pedidos o turnos online", "Cobro con Mercado Pago", "Informe de pedidos, turnos y ventas"],
  },
];

const metricas = [
  { valor: "1.240", etiqueta: "Visitas al sitio", cambio: "+18 %" },
  { valor: "312", etiqueta: "Clics a WhatsApp", cambio: "+24 %" },
  { valor: "86", etiqueta: "Pedidos o turnos", cambio: "+11 %" },
  { valor: "0,9 s", etiqueta: "Tiempo de carga", cambio: "Rápido" },
];

const busquedas = [
  { termino: "rotisería toay", veces: 214 },
  { termino: "comida para llevar toay", veces: 131 },
  { termino: "empanadas toay", veces: 96 },
];

const incluye = [
  { titulo: "Tráfico", texto: "Cuánta gente entra, desde qué celulares y de dónde llegan: Google, Instagram o WhatsApp." },
  { titulo: "Resultados", texto: "Clics al botón de WhatsApp, llamadas, pedidos y turnos. Lo que de verdad te trae clientes." },
  { titulo: "Google", texto: "Qué buscan para encontrarte, en qué posición aparecés y cuántos piden indicaciones para llegar." },
  { titulo: "Rendimiento", texto: "Velocidad de carga en celular y salud técnica del sitio. Si algo anda lento, lo arreglo." },
];

const pasos = [
  { titulo: "Charlamos", texto: "Te muestro cómo se vería tu negocio con una demo armada con tus fotos y productos." },
  { titulo: "Lo armo", texto: "En una o dos semanas tenés tu sitio listo para revisar desde el celular." },
  { titulo: "Lo publicamos", texto: "Con tu dominio .com.ar a tu nombre y tu ficha de Google Maps al día." },
  { titulo: "Me ocupo yo", texto: "Cambios de precios, fotos y horarios incluidos en el abono mensual. Me escribís y listo." },
];

const preguntas = [
  {
    p: "¿Tengo que pagar todo de entrada?",
    r: "No. Hay una opción sin pago inicial, solo con un abono mensual. Si preferís, también podés pagar el armado y un abono más bajo.",
  },
  {
    p: "¿Qué incluye el abono mensual?",
    r: "Dominio, hosting, seguridad, copias de respaldo, los cambios que necesites cada mes y un informe mensual con visitas, clics a WhatsApp y cómo te encuentran en Google.",
  },
  {
    p: "¿Cómo sé si la web me está sirviendo?",
    r: "Todos los meses te mando un informe simple por WhatsApp: cuánta gente entró, cuántos te escribieron, qué buscaron en Google para encontrarte y qué tan rápido carga tu sitio. Con eso decidimos qué mejorar.",
  },
  {
    p: "Ya tengo Instagram, ¿para qué quiero una web?",
    r: "La web no reemplaza a Instagram: lo potencia. Instagram te trae gente; la web te pone en Google y convierte esas visitas en pedidos.",
  },
  {
    p: "¿El dominio es mío?",
    r: "Sí. El dominio .com.ar se registra a nombre de tu negocio. Si algún día dejás de trabajar conmigo, te lo llevás.",
  },
  {
    p: "¿Puedo cobrar online?",
    r: "Sí, con Mercado Pago. Tus clientes pagan con tarjeta, débito o dinero en cuenta, y la plata te llega directo a tu cuenta.",
  },
  {
    p: "¿Y un bot de WhatsApp?",
    r: "Puedo sumar un asistente que responde precios, horarios y toma pedidos o turnos las 24 horas, y te pasa la conversación cuando hace falta una persona.",
  },
];

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "ProfessionalService",
  name: `${SITE.name} — Diseño web`,
  description: SITE.tagline,
  areaServed: ["Toay", "Santa Rosa", "La Pampa"],
  address: { "@type": "PostalAddress", addressLocality: "Toay", addressRegion: "La Pampa", addressCountry: "AR" },
  url: Astro.site?.toString(),
};
---

<Base
  title={`${SITE.name} | Páginas web para comercios de Toay y Santa Rosa`}
  description="Páginas web para comercios de Toay y Santa Rosa: aparecé en Google, mostrá tus precios y recibí pedidos y turnos por WhatsApp. Te armo una demo sin compromiso."
  jsonLd={jsonLd}
>
  <header class="sticky top-0 z-40 border-b border-monte-900/10 bg-arena-50/90 backdrop-blur">
    <nav class="mx-auto flex max-w-6xl items-center justify-between px-4 py-3">
      <a href="/" class="font-display text-xl font-bold text-monte-700">{SITE.name}</a>
      <div class="hidden items-center gap-6 text-sm font-medium md:flex">
        <a href="#demos" class="hover:text-monte-500">Demos</a>
        <a href="#planes" class="hover:text-monte-500">Planes</a>
        <a href="#informes" class="hover:text-monte-500">Informes</a>
        <a href="#como-trabajo" class="hover:text-monte-500">Cómo trabajo</a>
        <a href="#preguntas" class="hover:text-monte-500">Preguntas</a>
      </div>
      <a href={contacto} target="_blank" rel="noopener" class="btn-wa px-4 py-2">WhatsApp</a>
    </nav>
  </header>

  <main>
    <section class="relative overflow-hidden">
      <div class="mx-auto grid max-w-6xl items-center gap-12 px-4 py-16 md:grid-cols-2 md:py-24">
        <div>
          <p class="mb-4 inline-block rounded-full bg-monte-100 px-3 py-1 text-sm font-medium text-monte-700">
            Desde {SITE.city}
          </p>
          <h1 class="font-display text-4xl leading-tight font-bold text-balance md:text-5xl">
            Tu comercio ya tiene clientes en Instagram. Ahora, que te encuentren en Google y te pidan sin vueltas.
          </h1>
          <p class="mt-5 max-w-xl text-lg text-monte-900/75">
            Armo páginas web para negocios de la zona: rápidas, lindas en el celular y conectadas a tu WhatsApp. Yo me ocupo de todo, vos atendés tu negocio.
          </p>
          <div class="mt-8 flex flex-wrap gap-3">
            <a href="#demos" class="btn-primary">Ver ejemplos</a>
            <a href={contacto} target="_blank" rel="noopener" class="btn-ghost">Pedí tu demo gratis</a>
          </div>
        </div>
        <div class="relative mx-auto w-full max-w-md pb-10" aria-hidden="true">
          <div class="absolute -inset-6 rounded-[3rem] bg-arena-300/50 blur-2xl"></div>
          <div class="relative ml-auto aspect-[4/5] w-[78%] overflow-hidden rounded-[2rem] bg-arena-300 shadow-xl">
            <Foto src={F.duenoCelular} alt="" ancho={900} eager class="h-full w-full object-cover" />
          </div>
          <div class="absolute bottom-0 left-0 w-[56%] rounded-[2rem] border-[6px] border-monte-900 bg-white p-3 shadow-2xl">
            <div class="mb-2 h-20 overflow-hidden rounded-xl bg-gradient-to-br from-arena-500 to-arena-700 sm:h-24">
              <Foto src={F.empanadas} alt="" ancho={500} eager class="h-full w-full object-cover" />
            </div>
            <div class="mb-1.5 h-3 w-2/3 rounded bg-monte-900/80"></div>
            <div class="mb-3 h-2 w-1/2 rounded bg-monte-900/20"></div>
            <div class="space-y-1.5">
              {["Empanadas x12", "Pizza muzzarella", "Milanesa con fritas"].map((item) => (
                <div class="flex items-center justify-between gap-1 rounded-lg bg-arena-50 px-2 py-1.5 text-[10px] sm:text-xs">
                  <span class="truncate font-medium">{item}</span>
                  <span class="rounded-full bg-monte-700 px-1.5 text-arena-50">+</span>
                </div>
              ))}
            </div>
            <div class="mt-3 rounded-full bg-wa py-1.5 text-center text-[10px] font-semibold sm:text-xs">Enviar pedido por WhatsApp</div>
          </div>
        </div>
      </div>
    </section>

    <section class="mx-auto max-w-6xl px-4 pb-16">
      <p class="text-sm font-semibold tracking-wider text-monte-500 uppercase">Para todo tipo de comercio</p>
      <div class="mt-4 grid grid-cols-2 gap-3 md:grid-cols-3 lg:grid-cols-6">
        {rubros.map((r) => (
          <div class="relative flex h-32 items-end overflow-hidden rounded-2xl bg-monte-700 p-3 md:h-40">
            <Foto src={r.img} alt="" ancho={400} class="absolute inset-0 h-full w-full object-cover" />
            <div class="absolute inset-0 bg-gradient-to-t from-monte-900/85 via-monte-900/20 to-transparent"></div>
            <span class="relative text-sm leading-tight font-semibold text-white">{r.nombre}</span>
          </div>
        ))}
      </div>
    </section>

    <section class="bg-monte-900 text-arena-50">
      <div class="mx-auto max-w-6xl px-4 py-16">
        <h2 class="font-display text-3xl font-bold">¿Te suena?</h2>
        <div class="mt-8 grid gap-6 md:grid-cols-3">
          {problemas.map((p) => (
            <div class="rounded-2xl bg-white/5 p-6 ring-1 ring-white/10">
              <h3 class="text-lg font-semibold">{p.titulo}</h3>
              <p class="mt-2 text-arena-50/75">{p.texto}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <section id="demos" class="mx-auto max-w-6xl scroll-mt-20 px-4 py-20">
      <h2 class="font-display text-3xl font-bold">Mirá cómo puede quedar tu negocio</h2>
      <p class="mt-3 max-w-2xl text-monte-900/75">Cuatro ejemplos para rubros de la zona. Abrilos desde el celular y probá hacer un pedido, sacar un turno o consultar fechas.</p>
      <div class="mt-10 grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
        {demos.map((d) => (
          <a href={d.href} class="group overflow-hidden rounded-3xl bg-white shadow-sm ring-1 ring-monte-900/10 transition hover:-translate-y-1 hover:shadow-lg">
            <div class="relative flex h-44 items-end overflow-hidden bg-monte-700 p-5">
              <Foto src={d.img} alt="" ancho={700} class="absolute inset-0 h-full w-full object-cover transition duration-500 group-hover:scale-105" />
              <div class="absolute inset-0 bg-gradient-to-t from-black/70 to-transparent"></div>
              <span class="font-display relative text-3xl font-bold text-white">{d.nombre}</span>
            </div>
            <div class="p-5">
              <p class="text-sm font-semibold text-monte-500">{d.rubro}</p>
              <p class="mt-2 text-monte-900/75">{d.texto}</p>
              <p class="mt-4 font-semibold text-monte-700 group-hover:underline">Ver demo →</p>
            </div>
          </a>
        ))}
      </div>
    </section>

    <section id="planes" class="scroll-mt-20 bg-arena-100">
      <div class="mx-auto max-w-6xl px-4 py-20">
        <h2 class="font-display text-3xl font-bold">Planes</h2>
        <p class="mt-3 max-w-2xl text-monte-900/75">Todos incluyen dominio, hosting, seguridad y cambios mensuales. Hay opción sin pago inicial.</p>
        <div class="mt-10 grid gap-6 md:grid-cols-3">
          {planes.map((plan) => (
            <div class={`flex flex-col rounded-3xl p-7 ${plan.destacado ? "bg-monte-700 text-arena-50 shadow-xl" : "bg-white ring-1 ring-monte-900/10"}`}>
              {plan.destacado && <span class="mb-3 self-start rounded-full bg-arena-500 px-3 py-1 text-xs font-semibold text-monte-900">El más elegido</span>}
              <h3 class="font-display text-2xl font-bold">{plan.nombre}</h3>
              <p class={plan.destacado ? "text-arena-50/80" : "text-monte-900/70"}>{plan.para}</p>
              <ul class="mt-6 flex-1 space-y-3 text-sm">
                {plan.items.map((i) => (
                  <li class="flex gap-2">
                    <span class={plan.destacado ? "text-arena-300" : "text-monte-500"}>✓</span>
                    {i}
                  </li>
                ))}
              </ul>
              <a
                href={waLink(`Hola Joaquín, quiero consultar por el plan ${plan.nombre}.`)}
                target="_blank"
                rel="noopener"
                class={`mt-8 ${plan.destacado ? "btn bg-arena-50 text-monte-900 hover:bg-white" : "btn-primary"}`}
              >Consultar precio</a>
            </div>
          ))}
        </div>
        <div class="mt-6 rounded-3xl bg-white p-6 ring-1 ring-monte-900/10 md:flex md:items-center md:justify-between">
          <div>
            <h3 class="text-lg font-semibold">Extra: asistente de WhatsApp</h3>
            <p class="text-monte-900/70">Responde precios y horarios, toma pedidos y turnos las 24 horas, y te pasa la charla cuando hace falta.</p>
          </div>
          <a href={waLink("Hola Joaquín, quiero saber más del asistente de WhatsApp.")} target="_blank" rel="noopener" class="btn-ghost mt-4 shrink-0 md:mt-0">Quiero saber más</a>
        </div>
      </div>
    </section>

    <section id="informes" class="mx-auto max-w-6xl scroll-mt-20 px-4 py-20">
      <div class="grid items-start gap-12 md:grid-cols-2">
        <div>
          <h2 class="font-display text-3xl font-bold">Cada mes sabés si tu web vende</h2>
          <p class="mt-3 text-monte-900/75">Todos los planes incluyen un informe mensual, claro y sin palabras técnicas, que te llega por WhatsApp. Ves cuánta gente te encontró, cuántos te escribieron y qué conviene mejorar.</p>
          <div class="mt-8 grid gap-4 sm:grid-cols-2">
            {incluye.map((i) => (
              <div class="rounded-2xl bg-white p-5 ring-1 ring-monte-900/10">
                <h3 class="font-semibold text-monte-700">{i.titulo}</h3>
                <p class="mt-1 text-sm text-monte-900/75">{i.texto}</p>
              </div>
            ))}
          </div>
        </div>
        <div class="rounded-3xl bg-monte-900 p-6 text-arena-50 shadow-xl md:p-8">
          <div class="flex items-center justify-between text-sm">
            <p class="font-semibold">Informe de septiembre</p>
            <span class="rounded-full bg-white/10 px-2.5 py-0.5 text-xs">Ejemplo</span>
          </div>
          <p class="text-xs text-arena-50/60">Rotisería en Toay · comparado con agosto</p>
          <div class="mt-6 grid grid-cols-2 gap-3">
            {metricas.map((m) => (
              <div class="rounded-2xl bg-white/5 p-4 ring-1 ring-white/10">
                <p class="font-display text-3xl font-bold">{m.valor}</p>
                <p class="mt-1 text-xs text-arena-50/70">{m.etiqueta}</p>
                <p class="mt-2 text-xs font-semibold text-wa">{m.cambio}</p>
              </div>
            ))}
          </div>
          <p class="mt-6 text-xs font-semibold tracking-wider text-arena-300 uppercase">Cómo te buscaron en Google</p>
          <ul class="mt-3 space-y-2 text-sm">
            {busquedas.map((b) => (
              <li class="flex items-center gap-3">
                <span class="flex-1">{b.termino}</span>
                <span class="h-1.5 rounded-full bg-arena-500" style={`width:${Math.round((b.veces / busquedas[0].veces) * 6)}rem`}></span>
                <span class="w-8 text-right text-arena-50/70">{b.veces}</span>
              </li>
            ))}
          </ul>
          <p class="mt-6 rounded-2xl bg-white/5 p-4 text-sm"><strong>Recomendación del mes:</strong> los sábados a la noche se triplican las visitas. Conviene publicar el menú del fin de semana en Instagram el viernes.</p>
        </div>
      </div>
    </section>

    <section id="como-trabajo" class="mx-auto max-w-6xl scroll-mt-20 px-4 py-20">
      <h2 class="font-display text-3xl font-bold">Cómo trabajo</h2>
      <ol class="mt-10 grid gap-6 md:grid-cols-4">
        {pasos.map((paso, i) => (
          <li class="rounded-3xl bg-white p-6 ring-1 ring-monte-900/10">
            <span class="font-display text-4xl font-bold text-arena-500">{i + 1}</span>
            <h3 class="mt-2 text-lg font-semibold">{paso.titulo}</h3>
            <p class="mt-2 text-sm text-monte-900/75">{paso.texto}</p>
          </li>
        ))}
      </ol>
      <div class="mt-10 grid items-center gap-6 md:grid-cols-2">
        <div class="h-64 overflow-hidden rounded-3xl bg-monte-100 md:h-80">
          <Foto src={F.mostrador} alt="Charla con el dueño de un comercio en su mostrador" ancho={1000} class="h-full w-full object-cover" />
        </div>
        <div class="grid gap-4 text-sm">
          <p class="rounded-2xl bg-monte-100 p-4"><strong>Soy de Toay.</strong> Te visito en tu local y hablamos cara a cara.</p>
          <p class="rounded-2xl bg-monte-100 p-4"><strong>Te respondo yo.</strong> Sin tickets ni call centers: me escribís por WhatsApp.</p>
          <p class="rounded-2xl bg-monte-100 p-4"><strong>Lo tuyo es tuyo.</strong> El dominio queda a nombre de tu negocio.</p>
        </div>
      </div>
    </section>

    <section id="preguntas" class="scroll-mt-20 bg-white">
      <div class="mx-auto max-w-3xl px-4 py-20">
        <h2 class="font-display text-3xl font-bold">Preguntas frecuentes</h2>
        <div class="mt-8 divide-y divide-monte-900/10">
          {preguntas.map((q) => (
            <details class="group py-4">
              <summary class="flex cursor-pointer list-none items-center justify-between font-semibold">
                {q.p}
                <span class="ml-4 text-monte-500 transition group-open:rotate-45">+</span>
              </summary>
              <p class="mt-3 text-monte-900/75">{q.r}</p>
            </details>
          ))}
        </div>
      </div>
    </section>

    <section class="relative overflow-hidden bg-monte-700 text-arena-50">
      <Foto src={F.duenaLocal} alt="" ancho={1600} class="absolute inset-0 h-full w-full object-cover opacity-30" />
      <div class="absolute inset-0 bg-monte-700/70"></div>
      <div class="relative mx-auto max-w-4xl px-4 py-24 text-center">
        <h2 class="font-display text-3xl font-bold md:text-4xl">¿Te armo una demo de tu negocio?</h2>
        <p class="mx-auto mt-4 max-w-xl text-arena-50/80">Sin compromiso. Te muestro cómo se vería tu web con tus fotos y tus productos, y después decidís.</p>
        <a href={contacto} target="_blank" rel="noopener" class="btn-wa mt-8 px-8 py-4 text-base">Escribime por WhatsApp</a>
      </div>
    </section>
  </main>

  <footer class="bg-monte-900 text-arena-50/70">
    <div class="mx-auto flex max-w-6xl flex-col gap-2 px-4 py-8 text-sm md:flex-row md:justify-between">
      <p>© {new Date().getFullYear()} {SITE.name} · {SITE.city}</p>
      <p>{SITE.tagline}</p>
    </div>
  </footer>
</Base>

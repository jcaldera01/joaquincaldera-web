---
import Base from "../../layouts/Base.astro";
import DemoBar from "../../components/DemoBar.astro";
import Catalogo from "../../components/Catalogo.astro";
import Foto from "../../components/Foto.astro";
import { SITE, waLink } from "../../config";
import { F } from "../../fotos";

const servicios = [
  { titulo: "Consultas", texto: "Perros, gatos y animales de granja. Con turno o por orden de llegada.", img: F.consulta },
  { titulo: "Vacunación", texto: "Plan completo de cachorros y refuerzos anuales, con libreta sanitaria.", img: F.vacuna },
  { titulo: "Cirugías", texto: "Castraciones y cirugías programadas con quirófano propio.", img: F.revision },
  { titulo: "Peluquería canina", texto: "Baño, corte y deslanado. Te avisamos por WhatsApp cuando está listo.", img: F.perroBlanco },
];

// En un cliente real, el catálogo y el stock salen de Supabase.
const productos = [
  { nombre: "Alimento perro adulto 15 kg", categoria: "Alimentos", precio: 52000, img: F.alimentoPerro },
  { nombre: "Alimento perro cachorro 7,5 kg", categoria: "Alimentos", precio: 31000, img: F.cachorro },
  { nombre: "Alimento gato adulto 7,5 kg", categoria: "Alimentos", precio: 36000, img: F.alimentoGato },
  { nombre: "Pipeta antipulgas perro 10-20 kg", categoria: "Antiparasitarios", precio: 9500, img: F.perrosCorriendo },
  { nombre: "Comprimido antiparasitario interno", categoria: "Antiparasitarios", precio: 6800, img: F.labrador },
  { nombre: "Collar antipulgas gato", categoria: "Antiparasitarios", precio: 8200, img: F.gato },
  { nombre: "Correa y collar reforzado", categoria: "Accesorios", precio: 14000, img: F.correa },
  { nombre: "Cucha térmica mediana", categoria: "Accesorios", precio: 45000, img: F.perro },
  { nombre: "Piedras sanitarias 4 kg", categoria: "Accesorios", precio: 7500, img: F.gatoMano },
];

---

<Base title="Veterinaria El Caldén | Toay (demo)" description="Demo de sitio web para veterinaria: servicios, guardia, pet shop y consultas por WhatsApp.">
  <DemoBar rubro="veterinaria" />

  <div class="bg-[#f4f8f6] text-[#163328]" style="--accent:#2f6b55;--accent-dark:#1d4a3a;--soft:#e3efe9">
    <header class="relative overflow-hidden bg-[#1d4a3a] text-white">
      <Foto src={F.vetGato} alt="" ancho={1600} eager class="absolute inset-0 h-full w-full object-cover opacity-50" />
      <div class="absolute inset-0 bg-gradient-to-r from-[#1d4a3a] via-[#1d4a3a]/85 to-[#1d4a3a]/40"></div>
      <div class="relative mx-auto grid max-w-5xl gap-8 px-4 py-14 md:grid-cols-[1.4fr_1fr] md:items-center">
        <div>
          <h1 class="font-display text-5xl font-bold">Veterinaria El Caldén</h1>
          <p class="mt-3 max-w-md text-white/80">Cuidamos a tus animales desde hace más de 15 años en Toay. Clínica, cirugía, pet shop y peluquería canina.</p>
          <div class="mt-6 flex flex-wrap gap-3">
            <a href={waLink("[DEMO] Hola, quiero pedir un turno para mi mascota.")} target="_blank" rel="noopener" class="btn-wa">Pedir turno</a>
            <a href="#petshop" class="btn border border-white/40 text-white hover:bg-white/10">Ver pet shop</a>
          </div>
        </div>
        <div class="rounded-3xl bg-[#1d4a3a]/70 p-6 ring-1 ring-white/20 backdrop-blur">
          <p class="text-sm font-semibold tracking-wider text-[#f2c14e] uppercase">Guardia 24 h</p>
          <p class="mt-2 text-2xl font-bold">Urgencias todos los días</p>
          <a href={`tel:+${SITE.whatsapp}`} class="mt-4 inline-block rounded-full bg-[#f2c14e] px-5 py-2 font-semibold text-[#163328]">Llamar a la guardia</a>
          <p class="mt-4 text-sm text-white/70">Lun a vie 9 a 13 y 16 a 20 h · Sáb 9 a 13 h</p>
        </div>
      </div>
    </header>

    <section class="mx-auto max-w-5xl px-4 py-14">
      <h2 class="font-display text-3xl font-bold">Servicios</h2>
      <div class="mt-6 grid grid-cols-2 gap-3 sm:gap-4 md:grid-cols-4">
        {servicios.map((s) => (
          <div class="overflow-hidden rounded-2xl bg-white ring-1 ring-[#163328]/10">
            <div class="aspect-[3/2] bg-(--soft)">
              <Foto src={s.img} alt={s.titulo} ancho={500} class="h-full w-full object-cover" />
            </div>
            <div class="p-3 sm:p-5">
              <h3 class="font-semibold">{s.titulo}</h3>
              <p class="mt-2 text-sm text-[#163328]/70">{s.texto}</p>
            </div>
          </div>
        ))}
      </div>
    </section>

    <section id="petshop" class="mx-auto max-w-5xl scroll-mt-16 px-4 pb-14">
      <h2 class="font-display text-3xl font-bold">Pet shop</h2>
      <div class="mt-6">
        <Catalogo productos={productos} prefijo="[DEMO]" />
      </div>
    </section>

    <section class="bg-white">
      <div class="mx-auto grid max-w-5xl gap-8 px-4 py-14 md:grid-cols-2">
        <div>
          <h2 class="font-display text-3xl font-bold">Dónde estamos</h2>
          <p class="mt-3 text-[#163328]/70">Av. Perón 850, Toay, La Pampa. Estacionamiento en la puerta.</p>
          <p class="mt-2 text-[#163328]/70">Envíos de alimento sin cargo en Toay para compras desde $40.000.</p>
        </div>
        <iframe
          title="Mapa de Toay"
          class="h-64 w-full rounded-2xl border-0"
          loading="lazy"
          src="https://www.google.com/maps?q=Toay,+La+Pampa&output=embed"></iframe>
      </div>
    </section>
  </div>

</Base>

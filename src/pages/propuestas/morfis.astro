---
import Base from "../../layouts/Base.astro";
import PropuestaBar from "../../components/PropuestaBar.astro";
import PedidoMenu from "../../components/PedidoMenu.astro";

// Carta de ejemplo: se reemplaza por la carta real de Morfis antes de mostrarla.
const menu = [
  {
    categoria: "Hamburguesas",
    items: [
      { id: "h-clasica", nombre: "Hamburguesa clásica", precio: 9500, nota: "Con papas fritas" },
      { id: "h-cheddar", nombre: "Doble cheddar y panceta", precio: 12500, nota: "Con papas fritas" },
      { id: "h-veggie", nombre: "Hamburguesa de lentejas", precio: 9800 },
    ],
  },
  {
    categoria: "Lomitos y sándwiches",
    items: [
      { id: "lomito", nombre: "Lomito completo", precio: 14000, nota: "Lomo, jamón, queso, huevo, lechuga y tomate" },
      { id: "mila-sand", nombre: "Sándwich de milanesa", precio: 11000 },
    ],
  },
  {
    categoria: "Pizzas",
    items: [
      { id: "p-muzza", nombre: "Muzzarella", precio: 11500 },
      { id: "p-fugazzeta", nombre: "Fugazzeta rellena", precio: 14000 },
    ],
  },
  {
    categoria: "Para picar",
    items: [
      { id: "papas", nombre: "Papas fritas grandes", precio: 6000 },
      { id: "papas-cheddar", nombre: "Papas con cheddar y verdeo", precio: 8000 },
      { id: "nuggets", nombre: "Nuggets x10", precio: 7000 },
    ],
  },
  {
    categoria: "Bebidas",
    items: [
      { id: "gaseosa", nombre: "Gaseosa 1,5 l", precio: 4500 },
      { id: "agua", nombre: "Agua saborizada 1,5 l", precio: 3500 },
    ],
  },
];
---

<Base title="Morfis | Comidas en Toay (propuesta)" description="Propuesta de sitio web para Morfis: carta digital y pedidos por WhatsApp." noindex>
  <PropuestaBar negocio="Morfis" />

  <div class="bg-(--soft)" style="--accent:#e0461f;--accent-dark:#2b1d16;--soft:#fff6ea">
    <header class="relative overflow-hidden bg-(--accent-dark) text-white">
      <div class="absolute -top-24 -right-24 h-72 w-72 rounded-full bg-(--accent) opacity-80"></div>
      <div class="absolute right-24 -bottom-16 hidden h-40 w-40 rounded-full bg-[#ffb627] opacity-90 md:block"></div>
      <div class="relative mx-auto max-w-5xl px-4 py-16">
        <p class="text-sm font-semibold tracking-widest text-[#ffb627] uppercase">Comidas · Toay</p>
        <h1 class="font-display mt-2 text-6xl font-bold">Morfis</h1>
        <p class="mt-3 max-w-md text-white/85">Mirá la carta con precios actualizados, armá tu pedido y mandalo directo a nuestro WhatsApp. Sin esperar respuesta.</p>
        <div class="mt-6 flex flex-wrap gap-3">
          <a href="#Hamburguesas" class="btn bg-(--accent) text-white hover:brightness-110">Ver la carta</a>
          <a href="#ubicacion" class="btn border border-white/40 text-white hover:bg-white/10">Cómo llegar</a>
        </div>
      </div>
    </header>

    <p class="mx-auto max-w-5xl px-4 pt-6 text-sm text-black/60">Carta y precios de ejemplo. En el sitio real va la carta de Morfis, y la cambian ustedes desde un panel cuando suben los precios.</p>

    <PedidoMenu menu={menu} negocio="Morfis" prefijo="[PROPUESTA]" envio={1500} />

    <section id="ubicacion" class="scroll-mt-16 bg-white">
      <div class="mx-auto grid max-w-5xl gap-8 px-4 py-14 md:grid-cols-2">
        <div>
          <h2 class="font-display text-3xl font-bold">Dónde estamos</h2>
          <p class="mt-3 text-black/70">Toay, La Pampa. Retiro en el local o delivery.</p>
        </div>
        <iframe title="Mapa de Morfis" class="h-64 w-full rounded-2xl border-0" loading="lazy" src="https://www.google.com/maps?q=-36.6755641,-64.3750124&z=16&output=embed"></iframe>
      </div>
    </section>
  </div>
</Base>

---
import Base from "../../layouts/Base.astro";
import PropuestaBar from "../../components/PropuestaBar.astro";
import ReservaTurno from "../../components/ReservaTurno.astro";
import Foto from "../../components/Foto.astro";
import Redes from "../../components/Redes.astro";
import Galeria from "../../components/Galeria.astro";
import { F } from "../../fotos";

// Redes del comercio: pegá el link completo de cada una. Si queda vacía, el ícono se muestra de ejemplo.
const redes = { instagram: "", facebook: "", youtube: "" };

// Foto del frente tomada de su ficha de Google (subida por el dueño).
// Tratamientos, precios y demás fotos de ejemplo: se reemplazan por los reales de Santé.
const servicios = [
  { id: "limpieza", nombre: "Limpieza facial profunda", duracion: 60, precio: 22000, img: F.limpiezaFacial },
  { id: "dermaplaning", nombre: "Dermaplaning", duracion: 45, precio: 25000, img: F.dermaplaning },
  { id: "masaje", nombre: "Masaje descontracturante", duracion: 60, precio: 20000, img: F.masaje },
  { id: "drenaje", nombre: "Drenaje linfático", duracion: 60, precio: 21000, img: F.drenaje },
  { id: "pestanas", nombre: "Lifting de pestañas", duracion: 60, precio: 18000, img: F.pestanas },
  { id: "depilacion", nombre: "Depilación definitiva (por zona)", duracion: 30, precio: 15000, img: F.depilacion },
];

const galeria = [
  { src: "/propuestas/sante/fachada.jpg", alt: "Frente de Santé Salud & Estética" },
  { src: F.piedras, alt: "Masaje con piedras calientes" },
  { src: F.aceites, alt: "Aceites esenciales" },
  { src: F.masajeFacial, alt: "Masaje facial" },
  { src: F.toalla, alt: "Momento de relax" },
];

const horarios = ["09:00", "10:00", "11:00", "12:00", "16:00", "17:00", "18:00", "19:00"];
const fmt = (n: number) => n.toLocaleString("es-AR");
---

<Base title="Santé Salud & Estética | Toay (propuesta)" description="Propuesta de sitio web para Santé Salud & Estética: tratamientos y turnos online." noindex>
  <PropuestaBar negocio="Santé Salud & Estética" />

  <div class="min-h-screen bg-[#f7f4ef] text-[#2d3a35]" style="--accent:#8aa399;--accent-dark:#2d3a35;--soft:#e7eee9">
    <header class="mx-auto grid max-w-5xl items-center gap-10 px-4 py-16 md:grid-cols-2">
      <div>
        <p class="text-sm tracking-[0.3em] text-[#6f8a7f] uppercase">Salud & Estética · Toay</p>
        <h1 class="font-display mt-3 text-5xl leading-tight font-bold md:text-6xl">Santé</h1>
        <p class="mt-4 max-w-md text-[#2d3a35]/75">Tratamientos faciales, corporales y de bienestar. Elegí el tuyo y reservá el turno en un minuto, cuando quieras.</p>
        <a href="#turno" class="btn mt-6 bg-[#2d3a35] text-white hover:bg-[#1f2925]">Reservar turno</a>
      </div>
      <div class="relative mx-auto aspect-[4/5] w-full max-w-[15rem] md:max-w-xs">
        <div class="absolute -inset-3 rounded-t-full bg-[#dfe8e3]"></div>
        <div class="absolute inset-0 overflow-hidden rounded-t-full bg-[#c9d8d0]">
          <Foto src={F.facial} alt="Tratamiento facial en cabina" ancho={800} eager class="h-full w-full object-cover" />
        </div>
      </div>
    </header>

    <section class="mx-auto max-w-5xl px-4">
      <h2 class="font-display text-2xl font-bold">Tratamientos</h2>
      <p class="mt-1 text-sm text-black/55">Lista y precios de ejemplo. En el sitio real van los tratamientos de Santé.</p>
      <div class="mt-4 grid grid-cols-2 gap-3 md:grid-cols-3">
        {servicios.map((s) => (
          <div class="overflow-hidden rounded-2xl bg-white ring-1 ring-black/10">
            <div class="aspect-[3/2] bg-(--soft)">
              <Foto src={s.img} alt={s.nombre} ancho={600} class="h-full w-full object-cover" />
            </div>
            <div class="p-3 sm:p-5">
              <p class="font-semibold">{s.nombre}</p>
              <p class="mt-1 text-sm text-black/55">{s.duracion} min</p>
              <p class="mt-2 font-semibold text-[#5d7a6f]">${fmt(s.precio)}</p>
            </div>
          </div>
        ))}
      </div>
    </section>

    <section id="turno" class="mx-auto mt-14 max-w-3xl scroll-mt-16 px-4 pb-16">
      <div class="rounded-3xl bg-white p-6 shadow-sm ring-1 ring-black/10 md:p-8">
        <h2 class="font-display text-2xl font-bold">Reservá tu turno</h2>
        <div class="mt-6">
          <ReservaTurno servicios={servicios} horarios={horarios} diasCerrados={[0]} negocio="Santé Salud & Estética" prefijo="[PROPUESTA]" />
        </div>
      </div>
    </section>

    <section class="mx-auto max-w-5xl px-4 pb-16">
      <h2 class="font-display text-2xl font-bold">El espacio</h2>
      <div class="mt-4">
        <Galeria fotos={galeria} nota="La foto del frente es de su ficha de Google; las demás son de ejemplo. En el sitio real van fotos de las cabinas y de sus tratamientos." />
      </div>
    </section>

    <section class="bg-white">
      <div class="mx-auto grid max-w-5xl gap-8 px-4 py-14 md:grid-cols-2">
        <div>
          <h2 class="font-display text-3xl font-bold">Dónde estamos</h2>
          <p class="mt-3 text-black/70">Toay, La Pampa.</p>
          <Redes {...redes} negocio="Santé" nota="Íconos de ejemplo: en el sitio real llevan a sus redes." class="mt-8" />
        </div>
        <iframe title="Mapa de Santé" class="h-64 w-full rounded-2xl border-0" loading="lazy" src="https://www.google.com/maps?q=-36.6689356,-64.3652653&z=16&output=embed"></iframe>
      </div>
    </section>
  </div>
</Base>
